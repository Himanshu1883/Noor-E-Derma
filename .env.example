# Copy to .env.local and fill in secrets. Never commit .env.local.

APP_URL=http://localhost:3003

# MongoDB (Railway). Use authSource=admin — the default user authenticates against admin.
MONGODB_URI=mongodb://user:password@host:port/noor-e-derma?authSource=admin
MONGODB_DB=noor-e-derma

# At least 32 random characters. Used to HMAC session tokens.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Seeded on first `npm run seed`
ADMIN_EMAIL=admin@noorederma.example
ADMIN_PASSWORD=ChangeMe_Admin_123

# Google OAuth (optional until Google login is enabled)
# Create a Web client and set authorized redirect:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (test keys are fine for local)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (optional in dev — messages log to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NOOR E DERMA <hello@noorederma.example>"
